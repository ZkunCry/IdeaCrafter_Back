
# development | production
APP_ENV=production

# --- HTTP ---
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
# Origin'ы фронтенда через запятую. "*" нельзя: включены cookie-креденшелы.
CORS_ORIGINS=https://app.example.com

# --- Postgres ---

DB_HOST=db
DB_PORT=5432
DB_USER=startup
DB_PASSWORD=
DB_NAME=startup
DB_SSLMODE=disable
DB_POOL_SIZE=10
DB_MAX_IDLE_CONN=2

# --- JWT ---
ACCESS_SECRET=
REFRESH_SECRET=

# --- S3 ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
